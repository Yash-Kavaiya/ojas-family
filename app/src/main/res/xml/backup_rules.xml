<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and older. Only the member's own choices on this phone are backed up (theme, intro seen,
   reminder times). Firebase's sign-in state, installation id and push token must not be restored onto
   another phone: a restored copy would be stale and could stop notifications arriving.
-->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="sharedpref" path="reminders.xml" />
</full-backup-content>
