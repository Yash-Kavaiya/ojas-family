rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos and other per-user uploads: any signed-in member may view, only the owner writes
    match /users/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Thought of the Day pictures: admins upload, every signed-in member views
    match /thoughts/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.get('role', 'member') == 'admin'
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Guided practice video or audio (Practice tab): admins upload, every signed-in member streams
    match /practice/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.get('role', 'member') == 'admin'
        && (request.resource == null
          || (request.resource.size < 500 * 1024 * 1024
            && (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('audio/.*'))));
    }

    // Chat files: photos, PDFs and audio up to 20 MB, for the member and staff
    function chatFile() {
      return request.resource == null
        || (request.resource.size < 20 * 1024 * 1024
          && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('audio/.*')));
    }

    function staffRole() {
      return request.auth != null && request.auth.token.get('role', 'member') in ['admin', 'swamiji', 'senior_member'];
    }

    match /chats/{memberUid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == memberUid || staffRole());
      allow write: if request.auth != null && (request.auth.uid == memberUid || staffRole()) && chatFile();
    }

    match /adminChats/{memberUid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == memberUid || request.auth.token.get('role', 'member') == 'admin');
      allow write: if request.auth != null && (request.auth.uid == memberUid || request.auth.token.get('role', 'member') == 'admin') && chatFile();
    }

    // Announcement picture, audio or video: admins upload, every signed-in member views and plays
    match /announcements/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.get('role', 'member') == 'admin'
        && (request.resource == null
          || (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size < 30 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024));
    }
  }
}
