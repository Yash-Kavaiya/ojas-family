rules_version = '2';

// Points, levels, roles and payments are written only by Cloud Functions (Admin SDK bypasses rules).
// Clients may only touch the profile fields listed in userEditableFields().
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Roles come from a custom claim set by the setRole function; "senior_member" is the old name for a moderator
    function role() {
      let r = signedIn() ? request.auth.token.get('role', 'member') : 'member';
      return r == 'senior_member' ? 'moderator' : r;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Staff tools (answering chats, seeing profiles); moderators follow their own plan for everything else
    function isStaff() {
      return role() in ['admin', 'swamiji', 'moderator'];
    }

    // Swamiji and admins: every feature, no limits
    function fullAccess() {
      return role() in ['admin', 'swamiji'];
    }

    function viewerMemberLevel() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return me != null && me.data.get('memberLevel', 0) is int ? me.data.get('memberLevel', 0) : 0;
    }

    function userEditableFields() {
      return ['displayName', 'photoUrl', 'dob', 'gender', 'country', 'state', 'city', 'village', 'about', 'language',
              'profileComplete', 'hideProfile', 'hideGoals', 'notificationPrefs', 'fcmTokens',
              'morningReminder', 'nightReminder'];
    }

    function validProfile(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80))
        && (!('dob' in data) || (data.dob is string && data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('language' in data) || data.language in ['en', 'hi', 'gu'])
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 1000))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 80))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('state' in data) || (data.state is string && data.state.size() <= 80))
        && (!('morningReminder' in data) || (data.morningReminder is string && data.morningReminder.size() <= 5))
        && (!('nightReminder' in data) || (data.nightReminder is string && data.nightReminder.size() <= 5))
        && (!('fcmTokens' in data) || data.fcmTokens is list)
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('village' in data) || (data.village is string && data.village.size() <= 80))
        && (!('about' in data) || (data.about is string && data.about.size() <= 500))
        && (!('hideProfile' in data) || data.hideProfile is bool)
        && (!('hideGoals' in data) || data.hideGoals is bool)
        && (!('profileComplete' in data) || data.profileComplete is bool)
        && (!('notificationPrefs' in data) || data.notificationPrefs is map);
    }

    match /users/{uid} {
      // The full profile (with date of birth) is private; others see publicProfiles/{uid}
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // The client may create its own profile before onUserCreate runs; the function fills server fields
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(userEditableFields())
        && validProfile(request.resource.data)
        && request.resource.data.get('hideProfile', false) != true;

      // Turning hiding on needs Gold after a year (or Swamiji or an admin); turning it off is always allowed
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableFields())
        && validProfile(request.resource.data)
        && (request.resource.data.get('hideProfile', false) != true || resource.data.get('hideProfile', false) == true
            || allowed(100000, 100000, 365));

      allow delete: if false;

      // Pinned and muted chats, and a staff member's quick replies: private to the owner
      match /chatPrefs/{key} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /pointEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Ask Swamiji (AI) conversations: the member reads them; only Functions write (and delete)
      match /aiChats/{chatId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
        match /messages/{messageId} {
          allow read: if signedIn() && request.auth.uid == uid;
          allow write: if false;
        }
      }

      // Written by the logPractice function, which stamps the IST day itself
      match /practiceLog/{day} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Paid access: written only by Functions (Play Billing verification, admin grants)
      match /entitlements/{name} {
        allow read: if signedIn() && (request.auth.uid == uid || isStaff());
        allow write: if false;
      }
    }

    // What other people may see of a member (no date of birth). Staff and Member Level 3 can open
    // profiles; a member who hides their profile is visible to staff only.
    match /publicProfiles/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isStaff()
        || (viewerMemberLevel() >= 3 && resource.data.get('hidden', false) != true)
      );
      allow write: if false;
    }

    function validContent(data) {
      return data.section in ['blue_light', 'quick_protection', 'morning', 'night', 'yoga', 'other', 'understanding']
        && data.videoId is string && data.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && data.title is string && data.title.size() <= 200
        && data.get('minUserLevel', 1) is int
        && data.get('minMemberLevel', 0) is int
        && data.get('published', true) is bool;
    }

    // A member's own "I saw this", once: the doc can't be changed or removed, so a view is never
    // counted twice. A function then adds one to the post's viewCount, which members can't write.
    function validView(uid) {
      return signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // Ojas Healing videos: every member can browse; unlock levels are applied by the app,
    // since the videos themselves are public on YouTube
    match /content/{id} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      allow read: if signedIn();
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if isAdmin();
    }

    function validBook(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.url is string && data.url.size() <= 2000 && data.url.matches('^https://[^\\s]+$')
        && data.get('author', '') is string && data.get('author', '').size() <= 120
        && data.get('minUserLevel', 1) is int
        && data.get('minMemberLevel', 0) is int
        && data.get('order', 0) is int
        && data.get('published', true) is bool
        // The cover picture the admin uploaded (Storage books/covers), or none
        && data.get('coverUrl', '') is string && data.get('coverUrl', '').size() <= 2000
        && (data.get('coverUrl', '') == '' || data.get('coverUrl', '').matches('^https://[^\\s]+$'));
    }

    // PDF books on the Ask tab: an admin pastes each book's link; like the videos, the
    // unlock level is applied by the app
    match /books/{id} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      allow read: if signedIn();
      allow create, update: if isAdmin() && validBook(request.resource.data);
      allow delete: if isAdmin();
    }

    // Practice > Read: questions with their answers. Admins and Swamiji write them in the app;
    // every signed-in member reads. Which ones a member has read stays on their phone.
    function canWriteRead() {
      return role() in ['admin', 'swamiji'];
    }

    function validReadQa(data) {
      return data.keys().hasOnly(['question', 'answer', 'authorUid', 'createdAt', 'updatedAt'])
        && data.question is string && data.question.size() > 0 && data.question.size() <= 500
        && data.answer is string && data.answer.size() > 0 && data.answer.size() <= 10000
        && data.get('authorUid', '') is string && data.get('authorUid', '').size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /readQa/{id} {
      allow read: if signedIn();
      allow create: if canWriteRead() && validReadQa(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteRead() && validReadQa(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if canWriteRead();
    }

    // ---- Social (design §7.5, §7.6, §9) ----

    function viewer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rank(field) {
      return viewer().get(field, 0) is int ? viewer().get(field, 0) : 0;
    }

    // ---- Membership plans (owner's plan table, 2026-11-20) ----
    // Days on each plan before something opens: u for a free member (since joining), s for Silver and
    // g for Gold (since the paid plan began, while it runs). NEVER means that plan never gets it.
    // The same table is in the app (domain/PlanAccess.kt) and the server (functions/src/access.ts).

    function reached(ts, days) {
      return days == 0 || (ts is timestamp && request.time >= ts + duration.value(days, 'd'));
    }

    function onPlan(v, plan) {
      return v.get('plan', 'user') == plan && v.get('planUntil', null) is timestamp && v.planUntil > request.time;
    }

    function allowed(u, s, g) {
      let v = viewer();
      return fullAccess()
        || (u < 100000 && reached(v.get('createdAt', null), u))
        || (s < 100000 && onPlan(v, 'silver') && reached(v.get('planSince', null), s))
        || (g < 100000 && onPlan(v, 'gold') && reached(v.get('planSince', null), g));
    }

    // Paying now (Silver, Gold or the older membership): goal photos and pictures in comments
    function isPaidMember() {
      let v = viewer();
      return isStaff() || rank('memberLevel') >= 1 || onPlan(v, 'silver') || onPlan(v, 'gold');
    }

    // Likes anywhere: Free after 7 days, Silver and Gold from day 1 (NEVER = 100000)
    function canLike() {
      return signedIn() && allowed(7, 0, 0);
    }

    // Replies on the Thought of the Day and answers in Q&A
    function canReplyThought() {
      return signedIn() && allowed(182, 7, 7);
    }

    function canReplyAnnouncement() {
      return signedIn() && allowed(182, 7, 0);
    }

    // A question with words only; with a photo, audio or video it needs canAskMedia() too
    function canAskText() {
      return signedIn() && allowed(182, 7, 7);
    }

    function canAskMedia() {
      return signedIn() && allowed(365, 365, 182);
    }

    // Activity: reading and liking, replying, posting
    function canSeeActivity() {
      return signedIn() && allowed(100000, 182, 7);
    }

    function canReplyActivity() {
      return signedIn() && allowed(100000, 365, 182);
    }

    function canPostActivity() {
      return signedIn() && allowed(100000, 100000, 365);
    }

    function hasLink(text) {
      return text.matches('(?si).*(https?://|www[.]).*');
    }

    // Images in comments and replies: paying members and staff only (spec 1.1, 3)
    function canAttachImage() {
      return isPaidMember();
    }

    function hasImage(data) {
      return data.get('imageUrl', '') != '';
    }

    function validMedia(data) {
      return !('imageUrl' in data)
        || (data.imageUrl is string && data.imageUrl.size() < 1000 && (data.imageUrl == '' || canAttachImage()));
    }

    // Audio or video on an Activity post: the same members who may add a photo
    function validAv(data) {
      return validAvShape(data) && (!('mediaUrl' in data) || canAttachImage());
    }

    function validAvShape(data) {
      return (!('mediaUrl' in data) && !('mediaType' in data))
        || (data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() < 1000
          && data.mediaType in ['audio', 'video']);
    }

    // A question's photo, audio or video: allowed by the plan table rather than by paying
    function validQuestionMedia(data) {
      return (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 1000))
        && validAvShape(data)
        && (!(hasImage(data) || hasAv(data)) || canAskMedia());
    }

    function hasAv(data) {
      return data.get('mediaUrl', '') != '';
    }

    // People picked from the thread to be notified
    function validMentions(data) {
      return !('mentions' in data) || (data.mentions is list && data.mentions.size() <= 10);
    }

    // Level badges beside the author's name: optional, never higher than the author's real levels
    function validBadges(data) {
      return (!('authorLevel' in data) || (data.authorLevel is int && data.authorLevel >= 1 && data.authorLevel <= rank('userLevel')))
        && (!('authorMember' in data) || (data.authorMember is int && data.authorMember >= 1 && data.authorMember <= rank('memberLevel')));
    }

    // Author snapshot must be the caller, with the caller's real role; links and images wait for approval
    function validPost(data, maxLen) {
      return data.authorUid == request.auth.uid
        && data.authorRole == role()
        && data.authorName is string && data.authorName.size() <= 80
        && data.text is string && data.text.size() > 0 && data.text.size() <= maxLen
        && validMedia(data) && validMentions(data) && validBadges(data) && validReply(data)
        && data.status == ((hasLink(data.text) || hasImage(data)) ? 'pending' : 'visible');
    }

    // A reply names the top-level comment it hangs under (one level deep) and whom it answers
    function validReply(data) {
      return (!('parentId' in data) || (data.parentId is string && data.parentId.size() > 0 && data.parentId.size() <= 64))
        && (!('replyToName' in data) || (data.replyToName is string && data.replyToName.size() <= 80));
    }

    // The author changes the words of their own comment, answer, reply or Activity post. Nothing else
    // changes; a link that was not there before sends it back for approval.
    function ownTextEdit(maxLen, mayBeEmpty) {
      let d = request.resource.data;
      return signedIn() && resource.data.authorUid == request.auth.uid
        && d.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'status'])
        && d.text is string && d.text.size() <= maxLen && (mayBeEmpty || d.text.size() > 0)
        && d.editedAt == request.time
        && d.status == ((hasLink(d.text) && !hasLink(resource.data.get('text', ''))) ? 'pending' : resource.data.status);
    }

    // The same for a question's title and details
    function ownQuestionEdit() {
      let d = request.resource.data;
      let before = resource.data.get('title', '') + ' ' + resource.data.get('body', '');
      return signedIn() && resource.data.authorUid == request.auth.uid
        && d.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'editedAt', 'status'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.body is string && d.body.size() <= 2000
        && d.editedAt == request.time
        && d.status == ((hasLink(d.title + ' ' + d.body) && !hasLink(before)) ? 'pending' : resource.data.status);
    }

    function readablePost() {
      return signedIn() && (resource.data.status == 'visible' || resource.data.authorUid == request.auth.uid || isAdmin());
    }

    function validLike(uid) {
      return request.auth.uid == uid && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /thoughts/{thoughtId} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      // Members see today and the six days before. publishAt is midnight India time on the thought's day;
      // a day starts at 4 am local time, which comes first in UTC+14, 4.5 hours before midnight in India,
      // and last in UTC-12, so the window is a little wider than seven days. The app picks the local day.
      allow read: if isAdmin() || (signedIn()
        && resource.data.publishAt <= request.time + duration.value(270, 'm')
        && resource.data.publishAt > request.time - duration.value(8, 'd'));
      allow create, update: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && request.resource.data.publishAt is timestamp;
      allow delete: if isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if readablePost();
        allow create: if canReplyThought() && validPost(request.resource.data, 1000);
        allow update: if isAdmin() || ownTextEdit(1000, false);
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
        // Likes on a comment; the server keeps its likeCount
        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if canLike() && validLike(uid);
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    match /questions/{questionId} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      allow read: if readablePost();
      // How many a day is checked by the questionWritten function (a count can't be checked here)
      allow create: if canAskText()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && validQuestionMedia(request.resource.data)
        && validMentions(request.resource.data) && validBadges(request.resource.data)
        && request.resource.data.status == ((hasLink(request.resource.data.title + ' ' + request.resource.data.body)
             || hasImage(request.resource.data) || hasAv(request.resource.data)) ? 'pending' : 'visible');
      allow update: if isAdmin() || ownQuestionEdit();
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /answers/{answerId} {
        allow read: if readablePost();
        allow create: if canReplyThought() && validPost(request.resource.data, 1000);
        allow update: if isAdmin() || ownTextEdit(1000, false);
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
        // Likes on a comment; the server keeps its likeCount
        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if canLike() && validLike(uid);
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    match /announcements/{id} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      allow read: if signedIn();
      allow write: if isAdmin();

      // Same rules as liking and commenting on the Thought of the Day
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if readablePost();
        // Replies to an announcement are words only
        allow create: if canReplyAnnouncement() && validPost(request.resource.data, 1000) && !hasImage(request.resource.data);
        allow update: if isAdmin() || ownTextEdit(1000, false);
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
        // Likes on a comment; the server keeps its likeCount
        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if canLike() && validLike(uid);
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetPath', 'reason', 'createdAt'])
        && request.resource.data.targetPath is string && request.resource.data.targetPath.size() <= 500
        // An admin's "Remove the post" deletes this path: it may only ever name a member's post
        && request.resource.data.targetPath.matches('^(questions/[^/]+(/answers/[^/]+)?|thoughts/[^/]+/comments/[^/]+|announcements/[^/]+/comments/[^/]+|dailyPosts/[^/]+(/replies/[^/]+)?)$')
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /users/{uid}/blocked/{otherUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- The bell list: written by the server; the member reads it and marks lines read ----

    match /users/{uid}/notifications/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }

    // Which shared lines the member has seen: a time per group, and lines opened one by one
    match /users/{uid}/notificationState/{doc} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && doc == 'main'
        && request.resource.data.keys().hasOnly(['seen', 'opened'])
        && (!('seen' in request.resource.data) || request.resource.data.seen is map)
        && (!('opened' in request.resource.data) || (request.resource.data.opened is list && request.resource.data.opened.size() <= 300));
    }

    // New posts everyone may get (a thought, an announcement, a question): one line each
    match /broadcasts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid}/counters/{day} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Goals (design §7.8) ----

    match /goals/{goalId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Paid members submit a photo (it is also shared in Community > Activity); only admins approve or
    // reject. Daily sadhana goals are ticked through the tickGoal function, never written by the app.
    // Progress is private to its owner.
    match /users/{uid}/goalProgress/{goalId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isPaidMember() && request.auth.uid == uid
          && request.resource.data.status == 'submitted'
          && request.resource.data.keys().hasOnly(['status', 'photoUrl', 'note', 'submittedAt'])
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() < 1000
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && (resource == null || resource.data.status != 'approved'))
        || (isAdmin() && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if false;
    }

    match /{path=**}/goalProgress/{goalId} {
      allow read: if isAdmin();
    }

    // ---- Photo for healing (the opening animation): Silver after a year, Gold after 6 months; an admin approves ----
    match /facePhotos/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (signedIn() && request.auth.uid == uid && allowed(100000, 365, 182)
          && request.resource.data.status == 'submitted'
          && request.resource.data.keys().hasOnly(['status', 'photoUrl', 'submittedAt'])
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() > 0
          && request.resource.data.photoUrl.size() < 1000)
        || (isAdmin() && resource != null && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Admin moderation queue reads pending posts across every thread
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
    match /{path=**}/answers/{answerId} {
      allow read: if isAdmin();
    }

    // ---- Activity (spec 1.2): who reads, likes, replies and posts comes from the plan table ----

    // New Activity posts for the bell: only for those who may see Activity
    match /paidBroadcasts/{id} {
      allow read: if canSeeActivity();
      allow write: if false;
    }

    match /dailyPosts/{postId} {
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if validView(uid);
      }
      allow read: if canSeeActivity()
        && (resource.data.status == 'visible' || resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if canPostActivity()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role()
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        // Words, a photo, an audio clip or a video: never an empty post
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() < 1000
        && validAv(request.resource.data)
        && (request.resource.data.imageUrl.size() > 0 || request.resource.data.text.size() > 0 || hasAv(request.resource.data))
        && validMentions(request.resource.data) && validBadges(request.resource.data)
        && request.resource.data.status == (hasLink(request.resource.data.text) ? 'pending' : 'visible');
      // A post with a photo, audio or video may have its words emptied
      allow update: if isAdmin() || ownTextEdit(1000, hasImage(resource.data) || hasAv(resource.data));
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if canSeeActivity();
        allow create: if canSeeActivity() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /replies/{replyId} {
        allow read: if canSeeActivity() && readablePost();
        allow create: if canReplyActivity() && validPost(request.resource.data, 1000);
        allow update: if isAdmin() || ownTextEdit(1000, false);
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
        // Likes on a comment; the server keeps its likeCount
        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if canSeeActivity() && validLike(uid);
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    match /{path=**}/replies/{replyId} {
      allow read: if isAdmin();
    }

    // ---- Personal chat (spec 4.2) ----

    function hasEntitlement(name) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(name);
      return exists(path) && get(path).data.expiresAt > request.time;
    }

    // Paid chat and calls (plan table, 2026-11-20): bought separately on any plan; with the team
    // ('admin') from day 1, with Swamiji after 6 months. A call pack covers audio and video.
    function withSwamijiOpen(channel) {
      return channel != 'swamiji' || allowed(182, 182, 182);
    }

    function canChatNow(channel) {
      return isStaff() || (hasEntitlement('chat') && withSwamijiOpen(channel));
    }

    function canCallNow(channel) {
      return isStaff() || (canCall() && withSwamijiOpen(channel));
    }

    // A chat message: text and/or one photo, PDF or audio file
    // What each side of a chat may change on the thread: its own read time, typing time and unread count
    function memberThreadKeys() {
      return ['unreadByMember', 'unreadCountMember', 'memberReadAt', 'typingMember'];
    }

    function staffThreadKeys() {
      return ['unreadByStaff', 'unreadCountStaff', 'staffReadAt', 'typingStaff'];
    }

    // Read and typing times are the server's clock; an unread count may only be cleared, never raised
    function validThreadUpdate(member) {
      let d = request.resource.data;
      let o = resource.data;
      return member
        ? (d.get('unreadCountMember', 0) == 0 || d.get('unreadCountMember', 0) == o.get('unreadCountMember', 0))
          && (d.get('memberReadAt', null) == o.get('memberReadAt', null) || d.memberReadAt == request.time)
          && (d.get('typingMember', null) == o.get('typingMember', null) || d.typingMember == request.time)
        : (d.get('unreadCountStaff', 0) == 0 || d.get('unreadCountStaff', 0) == o.get('unreadCountStaff', 0))
          && (d.get('staffReadAt', null) == o.get('staffReadAt', null) || d.staffReadAt == request.time)
          && (d.get('typingStaff', null) == o.get('typingStaff', null) || d.typingStaff == request.time);
    }

    function validMessage(d) {
      return d.keys().hasOnly(['senderUid', 'text', 'attachment', 'createdAt'])
        && d.senderUid == request.auth.uid
        && d.text is string && d.text.size() <= 2000
        && (d.text.size() > 0 || 'attachment' in d)
        && (!('attachment' in d) || (d.attachment is map
          && d.attachment.keys().hasOnly(['url', 'name', 'mime', 'size', 'durationMs', 'waveform'])
          && (!('durationMs' in d.attachment) || (d.attachment.durationMs is int && d.attachment.durationMs >= 0 && d.attachment.durationMs <= 300000))
          && (!('waveform' in d.attachment) || (d.attachment.waveform is list && d.attachment.waveform.size() <= 64))
          && d.attachment.url is string && d.attachment.url.matches('https://.*') && d.attachment.url.size() < 1500
          && d.attachment.name is string && d.attachment.name.size() <= 200
          && d.attachment.mime is string
          && (d.attachment.mime.matches('image/.*') || d.attachment.mime == 'application/pdf' || d.attachment.mime.matches('audio/.*'))));
    }

    // Swamiji and admins see every chat; a moderator only the chats Swamiji assigned to them
    function canStaffChat(memberUid) {
      return role() in ['admin', 'swamiji']
        || (role() == 'moderator'
            && get(/databases/$(database)/documents/chats/$(memberUid)).data.get('assigneeUid', '') == request.auth.uid);
    }

    match /chats/{memberUid} {
      allow read: if signedIn() && (
        request.auth.uid == memberUid
        || role() in ['admin', 'swamiji']
        || (role() == 'moderator' && resource.data.get('assigneeUid', '') == request.auth.uid));
      allow create: if signedIn() && request.auth.uid == memberUid && canChatNow('swamiji')
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'createdAt'])
        && request.resource.data.memberUid == memberUid;
      allow update: if signedIn() && (
        (role() in ['admin', 'swamiji']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeUid', 'assigneeName'].concat(staffThreadKeys()))
          && validThreadUpdate(false))
        || (canStaffChat(memberUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffThreadKeys())
          && validThreadUpdate(false))
        || (request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberName', 'memberPhoto'].concat(memberThreadKeys()))
          && validThreadUpdate(true)));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == memberUid || canStaffChat(memberUid));
        allow create: if signedIn() && validMessage(request.resource.data)
          && ((request.auth.uid == memberUid && canChatNow('swamiji')) || canStaffChat(memberUid));
        allow update, delete: if false;
      }
    }

    // ---- The member's conversation with the Admin team: the member and every admin ----

    match /adminChats/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == memberUid || isAdmin());
      allow create: if signedIn() && request.auth.uid == memberUid && canChatNow('admin')
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'createdAt'])
        && request.resource.data.memberUid == memberUid;
      allow update: if signedIn() && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffThreadKeys()) && validThreadUpdate(false))
        || (request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberName', 'memberPhoto'].concat(memberThreadKeys()))
          && validThreadUpdate(true)));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == memberUid || isAdmin());
        allow create: if signedIn() && validMessage(request.resource.data)
          && ((request.auth.uid == memberUid && canChatNow('admin')) || isAdmin());
        allow update, delete: if false;
      }
    }

    // ---- Scheduled calls: the member requests a time, staff confirm, decline or propose another ----

    function staffForChannel(channel, memberUid) {
      return (channel == 'admin' && isAdmin()) || (channel == 'swamiji' && canStaffChat(memberUid));
    }

    match /callRequests/{id} {
      allow read: if signedIn() && (resource.data.memberUid == request.auth.uid
        || staffForChannel(resource.data.channel, resource.data.memberUid) || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'channel', 'video', 'at', 'note', 'status', 'createdAt'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.get('memberName', '') is string && request.resource.data.get('memberName', '').size() <= 80
        && request.resource.data.get('memberPhoto', '') is string && request.resource.data.get('memberPhoto', '').size() < 1000
        && request.resource.data.channel in ['swamiji', 'admin']
        && request.resource.data.video is bool
        && request.resource.data.at is timestamp && request.resource.data.at > request.time
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'pending'
        && canCallNow(request.resource.data.channel);
      allow update: if signedIn() && (
        // Staff: confirm, decline or propose a new time
        (staffForChannel(resource.data.channel, resource.data.memberUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proposedAt', 'staffUid', 'staffName', 'at'])
          && request.resource.data.status in ['confirmed', 'declined', 'proposed', 'cancelled']
          && (request.resource.data.status != 'proposed' || request.resource.data.proposedAt is timestamp))
        // Member: cancel, or accept a proposed time
        || (resource.data.memberUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at'])
          && (request.resource.data.status == 'cancelled'
            || (resource.data.status == 'proposed' && request.resource.data.status == 'confirmed'
              && request.resource.data.at == resource.data.proposedAt))));
      allow delete: if false;
    }

    // ---- Personal call (spec 4.3): WebRTC signalling between the two participants ----

    function isStaffUid(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'member') in ['admin', 'swamiji', 'moderator', 'senior_member'];
    }

    // An active call entitlement; a weekly pack also needs a call left
    function canCall() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/call;
      return exists(path) && get(path).data.expiresAt > request.time
        && (get(path).data.get('credits', null) == null || get(path).data.credits > 0);
    }

    function inCall(call) {
      // Written as two comparisons, not "uid in [caller, callee]": a query for "calls ringing for me"
      // (calleeUid == me) is only allowed when the rule can be proved from that one field
      return signedIn() && (call.callerUid == request.auth.uid || call.calleeUid == request.auth.uid);
    }

    match /calls/{callId} {
      // History: the member, the staff member on the call, and admins
      allow read: if inCall(resource.data) || (signedIn() && (resource.data.memberUid == request.auth.uid
        || resource.data.staffUid == request.auth.uid || isAdmin()));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['callerUid', 'calleeUid', 'memberUid', 'staffUid', 'status', 'offer', 'createdAt',
             'video', 'channel', 'requestId', 'callerName', 'calleeName'])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.get('video', false) is bool
        && request.resource.data.get('channel', 'swamiji') in ['swamiji', 'admin']
        && ((isStaff() && request.resource.data.staffUid == request.auth.uid
              && request.resource.data.memberUid == request.resource.data.calleeUid)
          || (request.resource.data.memberUid == request.auth.uid
              && request.resource.data.staffUid == request.resource.data.calleeUid
              && isStaffUid(request.resource.data.calleeUid)
              && canCallNow(request.resource.data.get('channel', 'swamiji'))));
      // Either side: status and answer; the callee's phone marks it delivered (ringing); restart fields
      // carry a new offer/answer when the connection is repaired after a network change
      allow update: if inCall(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'endedAt', 'deliveredAt', 'restartOffer', 'restartAnswer'])
        && (!('deliveredAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.auth.uid == resource.data.calleeUid)
        && request.resource.data.status in ['ringing', 'active', 'ended', 'declined', 'missed']
        // A call that is over stays over: it cannot be answered late or have its outcome rewritten
        && (!(resource.data.status in ['ended', 'declined', 'missed']) || request.resource.data.status == resource.data.status);
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read: if inCall(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if inCall(get(/databases/$(database)/documents/calls/$(callId)).data)
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Online / last seen: the owner's heartbeat. Members see staff; staff see everyone
    match /presence/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff() || isStaffUid(uid));
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastActiveAt']) && request.resource.data.lastActiveAt == request.time;
    }

    // Ask Swamiji (AI) grounding passages and build marks: Functions and scripts only
    match /knowledge/{chunkId} {
      allow read, write: if false;
    }
    match /knowledgeSources/{videoId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Thumbs up/down on AI answers, for admins to review
    match /aiFeedback/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Daily usage numbers for the admin dashboard, written by the server only
    match /stats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Moksha Point gifts between members: the two members, Swamiji and admins can read them
    match /pointTransfers/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
        || role() in ['admin', 'swamiji']);
      allow write: if false;
    }
    // Every change Swamiji or an admin makes to someone's points
    match /pointAdjustments/{id} {
      allow read: if role() in ['admin', 'swamiji'];
      allow write: if false;
    }

    // App settings every member needs (levels, staff, practice media, about). The admin email list
    // is personal data: only admins read it
    match /config/{docId} {
      allow read: if signedIn() && (docId != 'admins' || isAdmin());
      allow write: if isAdmin();
    }
  }
}
