rules_version = '2';

// Points, levels, roles and payments are written only by Cloud Functions (Admin SDK bypasses rules).
// Clients may only touch the profile fields listed in userEditableFields().
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Roles come from a custom claim set by the setRole function
    function role() {
      return signedIn() ? request.auth.token.get('role', 'member') : 'member';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() in ['admin', 'swamiji', 'senior_member'];
    }

    function viewerMemberLevel() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return me != null && me.data.get('memberLevel', 0) is int ? me.data.get('memberLevel', 0) : 0;
    }

    function userEditableFields() {
      return ['displayName', 'photoUrl', 'dob', 'gender', 'country', 'state', 'city', 'village', 'about', 'language',
              'profileComplete', 'hideProfile', 'hideGoals', 'notificationPrefs', 'fcmTokens',
              'morningReminder', 'nightReminder'];
    }

    function validProfile(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80))
        && (!('dob' in data) || (data.dob is string && data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('language' in data) || data.language in ['en', 'hi', 'gu'])
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('village' in data) || (data.village is string && data.village.size() <= 80))
        && (!('about' in data) || (data.about is string && data.about.size() <= 500))
        && (!('hideProfile' in data) || data.hideProfile is bool)
        && (!('hideGoals' in data) || data.hideGoals is bool)
        && (!('profileComplete' in data) || data.profileComplete is bool)
        && (!('notificationPrefs' in data) || data.notificationPrefs is map);
    }

    match /users/{uid} {
      // The full profile (with date of birth) is private; others see publicProfiles/{uid}
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // The client may create its own profile before onUserCreate runs; the function fills server fields
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(userEditableFields())
        && validProfile(request.resource.data)
        && request.resource.data.get('hideProfile', false) != true;

      // Turning hiding on needs User Level 3 (or a staff role); turning it off is always allowed
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableFields())
        && validProfile(request.resource.data)
        && (request.resource.data.get('hideProfile', false) != true || resource.data.get('hideProfile', false) == true
            || isStaff() || resource.data.get('userLevel', 1) >= 3);

      allow delete: if false;

      match /pointEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Written by the logPractice function, which stamps the IST day itself
      match /practiceLog/{day} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Paid access: written only by Functions (Play Billing verification, admin grants)
      match /entitlements/{name} {
        allow read: if signedIn() && (request.auth.uid == uid || isStaff());
        allow write: if false;
      }
    }

    // What other people may see of a member (no date of birth). Staff and Member Level 3 can open
    // profiles; a member who hides their profile is visible to staff only.
    match /publicProfiles/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isStaff()
        || (viewerMemberLevel() >= 3 && resource.data.get('hidden', false) != true)
      );
      allow write: if false;
    }

    function validContent(data) {
      return data.section in ['blue_light', 'quick_protection', 'morning', 'night', 'yoga', 'other', 'understanding']
        && data.videoId is string && data.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && data.title is string && data.title.size() <= 200
        && data.get('minUserLevel', 1) is int
        && data.get('minMemberLevel', 0) is int
        && data.get('published', true) is bool;
    }

    // Ojas Healing videos: every member can browse; unlock levels are applied by the app,
    // since the videos themselves are public on YouTube
    match /content/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Social (design §7.5, §7.6, §9) ----

    function viewer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rank(field) {
      return viewer().get(field, 0) is int ? viewer().get(field, 0) : 0;
    }

    // Like: User Level 2, or any paid member
    function canLike() {
      return signedIn() && (isStaff() || rank('userLevel') >= 2 || rank('memberLevel') >= 1);
    }

    // Comment, answer, ask: User Level 3, or Member Level 2
    function canComment() {
      return signedIn() && (isStaff() || rank('userLevel') >= 3 || rank('memberLevel') >= 2);
    }

    function hasLink(text) {
      return text.matches('(?s).*(https?://|www[.]).*');
    }

    // Images in posts: paid members and staff only (spec 1.1, 3)
    function canAttachImage() {
      return isStaff() || rank('memberLevel') >= 1;
    }

    function hasImage(data) {
      return data.get('imageUrl', '') != '';
    }

    function validMedia(data) {
      return !('imageUrl' in data)
        || (data.imageUrl is string && data.imageUrl.size() < 1000 && (data.imageUrl == '' || canAttachImage()));
    }

    // People picked from the thread to be notified
    function validMentions(data) {
      return !('mentions' in data) || (data.mentions is list && data.mentions.size() <= 10);
    }

    // Level badges beside the author's name: optional, never higher than the author's real levels
    function validBadges(data) {
      return (!('authorLevel' in data) || (data.authorLevel is int && data.authorLevel >= 1 && data.authorLevel <= rank('userLevel')))
        && (!('authorMember' in data) || (data.authorMember is int && data.authorMember >= 1 && data.authorMember <= rank('memberLevel')));
    }

    // Author snapshot must be the caller, with the caller's real role; links and images wait for approval
    function validPost(data, maxLen) {
      return data.authorUid == request.auth.uid
        && data.authorRole == role()
        && data.authorName is string && data.authorName.size() <= 80
        && data.text is string && data.text.size() > 0 && data.text.size() <= maxLen
        && validMedia(data) && validMentions(data) && validBadges(data)
        && data.status == ((hasLink(data.text) || hasImage(data)) ? 'pending' : 'visible');
    }

    function readablePost() {
      return signedIn() && (resource.data.status == 'visible' || resource.data.authorUid == request.auth.uid || isAdmin());
    }

    function validLike(uid) {
      return request.auth.uid == uid && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /thoughts/{thoughtId} {
      // Members see today and the six days before; scheduled thoughts stay hidden until their day
      allow read: if isAdmin() || (signedIn()
        && resource.data.publishAt <= request.time
        && resource.data.publishAt > request.time - duration.value(7, 'd'));
      allow create, update: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && request.resource.data.publishAt is timestamp;
      allow delete: if isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if readablePost();
        allow create: if canComment() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /questions/{questionId} {
      allow read: if readablePost();
      allow create: if canComment()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && validMedia(request.resource.data) && validMentions(request.resource.data) && validBadges(request.resource.data)
        && request.resource.data.status == ((hasLink(request.resource.data.title + ' ' + request.resource.data.body)
             || hasImage(request.resource.data)) ? 'pending' : 'visible');
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /answers/{answerId} {
        allow read: if readablePost();
        allow create: if canComment() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // Same rules as liking and commenting on the Thought of the Day
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if readablePost();
        allow create: if canComment() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetPath is string && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /users/{uid}/blocked/{otherUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/counters/{day} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Goals (design §7.8) ----

    match /goals/{goalId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Members submit a photo; only admins approve or reject. Progress is private to its owner.
    match /users/{uid}/goalProgress/{goalId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.status == 'submitted'
          && request.resource.data.keys().hasOnly(['status', 'photoUrl', 'note', 'submittedAt'])
          && request.resource.data.photoUrl is string
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && (resource == null || resource.data.status != 'approved'))
        || (isAdmin() && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if false;
    }

    match /{path=**}/goalProgress/{goalId} {
      allow read: if isAdmin();
    }

    // Admin moderation queue reads pending posts across every thread
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
    match /{path=**}/answers/{answerId} {
      allow read: if isAdmin();
    }

    // ---- Daily Activities (spec 1.2): paid members read, like and reply; Member Level 3 posts ----

    function isPaid() {
      return signedIn() && (isStaff() || rank('memberLevel') >= 1);
    }

    match /dailyPosts/{postId} {
      allow read: if isPaid()
        && (resource.data.status == 'visible' || resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && (isStaff() || rank('memberLevel') >= 3)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role()
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0
        && request.resource.data.imageUrl.size() < 1000
        && validMentions(request.resource.data) && validBadges(request.resource.data)
        && request.resource.data.status == (hasLink(request.resource.data.text) ? 'pending' : 'visible');
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if isPaid();
        allow create: if isPaid() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /replies/{replyId} {
        allow read: if isPaid() && readablePost();
        allow create: if isPaid() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /{path=**}/replies/{replyId} {
      allow read: if isAdmin();
    }

    // ---- Personal chat (spec 4.2) ----

    function hasEntitlement(name) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(name);
      return exists(path) && get(path).data.expiresAt > request.time;
    }

    // Access by member level (owner 2026-11-07): Level 1 chat, Level 2 audio calls, Level 3 video calls.
    // memberLevel is 0 while membership is inactive, so a level means "paying now". Packs still work.
    function canChatNow() {
      return isStaff() || rank('memberLevel') >= 1 || hasEntitlement('chat');
    }

    function canAudioNow() {
      return isStaff() || rank('memberLevel') >= 2 || canCall();
    }

    function canVideoNow() {
      return isStaff() || rank('memberLevel') >= 3;
    }

    // A chat message: text and/or one photo, PDF or audio file
    function validMessage(d) {
      return d.keys().hasOnly(['senderUid', 'text', 'attachment', 'createdAt'])
        && d.senderUid == request.auth.uid
        && d.text is string && d.text.size() <= 2000
        && (d.text.size() > 0 || 'attachment' in d)
        && (!('attachment' in d) || (d.attachment is map
          && d.attachment.keys().hasOnly(['url', 'name', 'mime', 'size'])
          && d.attachment.url is string && d.attachment.url.matches('https://.*') && d.attachment.url.size() < 1500
          && d.attachment.name is string && d.attachment.name.size() <= 200
          && d.attachment.mime is string
          && (d.attachment.mime.matches('image/.*') || d.attachment.mime == 'application/pdf' || d.attachment.mime.matches('audio/.*'))));
    }

    // Swamiji and admins see every chat; a senior member only the chats Swamiji assigned to them
    function canStaffChat(memberUid) {
      return role() in ['admin', 'swamiji']
        || (role() == 'senior_member'
            && get(/databases/$(database)/documents/chats/$(memberUid)).data.get('assigneeUid', '') == request.auth.uid);
    }

    match /chats/{memberUid} {
      allow read: if signedIn() && (
        request.auth.uid == memberUid
        || role() in ['admin', 'swamiji']
        || (role() == 'senior_member' && resource.data.get('assigneeUid', '') == request.auth.uid));
      allow create: if signedIn() && request.auth.uid == memberUid && canChatNow()
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'createdAt'])
        && request.resource.data.memberUid == memberUid;
      allow update: if signedIn() && (
        (role() in ['admin', 'swamiji']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeUid', 'assigneeName', 'unreadByStaff']))
        || (canStaffChat(memberUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByStaff']))
        || (request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByMember', 'memberName', 'memberPhoto'])));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == memberUid || canStaffChat(memberUid));
        allow create: if signedIn() && validMessage(request.resource.data)
          && ((request.auth.uid == memberUid && canChatNow()) || canStaffChat(memberUid));
        allow update, delete: if false;
      }
    }

    // ---- The member's conversation with the Admin team: the member and every admin ----

    match /adminChats/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == memberUid || isAdmin());
      allow create: if signedIn() && request.auth.uid == memberUid && canChatNow()
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'createdAt'])
        && request.resource.data.memberUid == memberUid;
      allow update: if signedIn() && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByStaff']))
        || (request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByMember', 'memberName', 'memberPhoto'])));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == memberUid || isAdmin());
        allow create: if signedIn() && validMessage(request.resource.data)
          && ((request.auth.uid == memberUid && canChatNow()) || isAdmin());
        allow update, delete: if false;
      }
    }

    // ---- Scheduled calls: the member requests a time, staff confirm, decline or propose another ----

    function staffForChannel(channel, memberUid) {
      return (channel == 'admin' && isAdmin()) || (channel == 'swamiji' && canStaffChat(memberUid));
    }

    match /callRequests/{id} {
      allow read: if signedIn() && (resource.data.memberUid == request.auth.uid
        || staffForChannel(resource.data.channel, resource.data.memberUid) || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUid', 'memberName', 'memberPhoto', 'channel', 'video', 'at', 'note', 'status', 'createdAt'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.channel in ['swamiji', 'admin']
        && request.resource.data.video is bool
        && request.resource.data.at is timestamp && request.resource.data.at > request.time
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'pending'
        && (request.resource.data.video ? canVideoNow() : canAudioNow());
      allow update: if signedIn() && (
        // Staff: confirm, decline or propose a new time
        (staffForChannel(resource.data.channel, resource.data.memberUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proposedAt', 'staffUid', 'staffName', 'at'])
          && request.resource.data.status in ['confirmed', 'declined', 'proposed', 'cancelled']
          && (request.resource.data.status != 'proposed' || request.resource.data.proposedAt is timestamp))
        // Member: cancel, or accept a proposed time
        || (resource.data.memberUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at'])
          && (request.resource.data.status == 'cancelled'
            || (resource.data.status == 'proposed' && request.resource.data.status == 'confirmed'
              && request.resource.data.at == resource.data.proposedAt))));
      allow delete: if false;
    }

    // ---- Personal call (spec 4.3): WebRTC signalling between the two participants ----

    function isStaffUid(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'member') in ['admin', 'swamiji', 'senior_member'];
    }

    // An active call entitlement; a weekly pack also needs a call left
    function canCall() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/entitlements/call;
      return exists(path) && get(path).data.expiresAt > request.time
        && (get(path).data.get('credits', null) == null || get(path).data.credits > 0);
    }

    function inCall(call) {
      return signedIn() && request.auth.uid in [call.callerUid, call.calleeUid];
    }

    match /calls/{callId} {
      // History: the member, the staff member on the call, and admins
      allow read: if inCall(resource.data) || (signedIn() && (resource.data.memberUid == request.auth.uid
        || resource.data.staffUid == request.auth.uid || isAdmin()));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['callerUid', 'calleeUid', 'memberUid', 'staffUid', 'status', 'offer', 'createdAt',
             'video', 'channel', 'requestId', 'callerName', 'calleeName'])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.get('video', false) is bool
        && request.resource.data.get('channel', 'swamiji') in ['swamiji', 'admin']
        && ((isStaff() && request.resource.data.staffUid == request.auth.uid
              && request.resource.data.memberUid == request.resource.data.calleeUid)
          || (request.resource.data.memberUid == request.auth.uid
              && request.resource.data.staffUid == request.resource.data.calleeUid
              && isStaffUid(request.resource.data.calleeUid)
              && (request.resource.data.get('video', false) ? canVideoNow() : canAudioNow())));
      allow update: if inCall(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'endedAt'])
        && request.resource.data.status in ['ringing', 'active', 'ended', 'declined', 'missed'];
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read: if inCall(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if inCall(get(/databases/$(database)/documents/calls/$(callId)).data)
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
