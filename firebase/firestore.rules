rules_version = '2';

// Points, levels, roles and payments are written only by Cloud Functions (Admin SDK bypasses rules).
// Clients may only touch the profile fields listed in userEditableFields().
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Roles come from a custom claim set by the setRole function
    function role() {
      return signedIn() ? request.auth.token.get('role', 'member') : 'member';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() in ['admin', 'swamiji', 'senior_member'];
    }

    function viewerMemberLevel() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return me != null && me.data.get('memberLevel', 0) is int ? me.data.get('memberLevel', 0) : 0;
    }

    function userEditableFields() {
      return ['displayName', 'photoUrl', 'dob', 'gender', 'country', 'state', 'city', 'language',
              'profileComplete', 'hideProfile', 'hideGoals', 'notificationPrefs', 'fcmTokens',
              'morningReminder', 'nightReminder'];
    }

    function validProfile(data) {
      return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80))
        && (!('dob' in data) || (data.dob is string && data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('language' in data) || data.language in ['en', 'hi', 'gu'])
        && (!('hideProfile' in data) || data.hideProfile is bool)
        && (!('hideGoals' in data) || data.hideGoals is bool)
        && (!('profileComplete' in data) || data.profileComplete is bool)
        && (!('notificationPrefs' in data) || data.notificationPrefs is map);
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || isStaff()
        || (viewerMemberLevel() >= 3 && resource.data.get('hideProfile', false) != true)
      );

      // The client may create its own profile before onUserCreate runs; the function fills server fields
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(userEditableFields())
        && validProfile(request.resource.data);

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableFields())
        && validProfile(request.resource.data);

      allow delete: if false;

      match /pointEvents/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    function validContent(data) {
      return data.section in ['blue_light', 'quick_protection', 'morning', 'night', 'yoga', 'other', 'understanding']
        && data.videoId is string && data.videoId.matches('^[A-Za-z0-9_-]{11}$')
        && data.title is string && data.title.size() <= 200
        && data.get('minUserLevel', 1) is int
        && data.get('minMemberLevel', 0) is int
        && data.get('published', true) is bool;
    }

    // Ojas Healing videos: every member can browse; unlock levels are applied by the app,
    // since the videos themselves are public on YouTube
    match /content/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validContent(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Social (design §7.5, §7.6, §9) ----

    function viewer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rank(field) {
      return viewer().get(field, 0) is int ? viewer().get(field, 0) : 0;
    }

    // Like: User Level 2, or any paid member
    function canLike() {
      return signedIn() && (isStaff() || rank('userLevel') >= 2 || rank('memberLevel') >= 1);
    }

    // Comment, answer, ask: User Level 3, or Member Level 2
    function canComment() {
      return signedIn() && (isStaff() || rank('userLevel') >= 3 || rank('memberLevel') >= 2);
    }

    function hasLink(text) {
      return text.matches('(?s).*(https?://|www[.]).*');
    }

    // Author snapshot must be the caller, with the caller's real role; links wait for approval
    function validPost(data, maxLen) {
      return data.authorUid == request.auth.uid
        && data.authorRole == role()
        && data.authorName is string && data.authorName.size() <= 80
        && data.text is string && data.text.size() > 0 && data.text.size() <= maxLen
        && data.status == (hasLink(data.text) ? 'pending' : 'visible');
    }

    function readablePost() {
      return signedIn() && (resource.data.status == 'visible' || resource.data.authorUid == request.auth.uid || isAdmin());
    }

    function validLike(uid) {
      return request.auth.uid == uid && request.resource.data.keys().hasOnly(['createdAt']);
    }

    match /thoughts/{thoughtId} {
      // Members see today and the six days before; scheduled thoughts stay hidden until their day
      allow read: if isAdmin() || (signedIn()
        && resource.data.publishAt <= request.time
        && resource.data.publishAt > request.time - duration.value(7, 'd'));
      allow create, update: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.text is string && request.resource.data.text.size() <= 5000
        && request.resource.data.publishAt is timestamp;
      allow delete: if isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if readablePost();
        allow create: if canComment() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /questions/{questionId} {
      allow read: if readablePost();
      allow create: if canComment()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && request.resource.data.status == (hasLink(request.resource.data.title + ' ' + request.resource.data.body) ? 'pending' : 'visible');
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canLike() && validLike(uid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /answers/{answerId} {
        allow read: if readablePost();
        allow create: if canComment() && validPost(request.resource.data, 1000);
        allow update: if isAdmin();
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetPath is string && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, delete: if isAdmin();
    }

    match /users/{uid}/blocked/{otherUid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/counters/{day} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Goals (design §7.8) ----

    match /goals/{goalId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Members submit a photo; only admins approve or reject. Progress is private to its owner.
    match /users/{uid}/goalProgress/{goalId} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.status == 'submitted'
          && request.resource.data.keys().hasOnly(['status', 'photoUrl', 'note', 'submittedAt'])
          && request.resource.data.photoUrl is string
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && (resource == null || resource.data.status != 'approved'))
        || (isAdmin() && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if false;
    }

    match /{path=**}/goalProgress/{goalId} {
      allow read: if isAdmin();
    }

    // Admin moderation queue reads pending posts across every thread
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
    match /{path=**}/answers/{answerId} {
      allow read: if isAdmin();
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
